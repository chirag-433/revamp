# Leave DATABASE_URL unset to use the local SQLite database.
# For PostgreSQL, supply a connection URL through your local shell environment.
DATABASE_URL=postgresql://revamp:change-me@localhost:5432/revamp
DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEMO_PUBLIC_READONLY=1
STRICT_ROLE_SCOPING=0
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_SECONDS=900
DJANGO_SECURE_SSL_REDIRECT=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
POSTGRES_DB=sih
POSTGRES_USER=sih
POSTGRES_PASSWORD=local-development-only
# Keep this server-side. Never put the Sarvam key in templates or JavaScript.
SARVAM_API_KEY=replace-with-your-sarvam-api-key
